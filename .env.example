# Clerk — the same Clerk instance as the backend and the admin dashboard (dashboard.clerk.com → API keys).
# See the backend repo's docs/clerk-setup.md for the instance settings this app expects.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Where invitation emails land; set the backend's CLERK_INVITATION_REDIRECT_URL to http://localhost:3000/sign-up.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# The backend's tenant API. Called from the browser with the signed-in user's session token,
# so the backend's CLERK_AUTHORIZED_PARTIES must include this app's origin (http://localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
